# Maintainer: stuffz
#
# Build and install:
#   make package
#
# Sources the local repository rather than a remote, so it packages what is
# committed on this machine and needs no network. pkgver below is a
# placeholder; pkgver() sets the real one at build time, and `make package`
# runs makepkg on a copy so this file is not rewritten.

pkgname=airpods-git
_pkgname=airpods
pkgver=r0.g0000000
pkgrel=1
pkgdesc="AirPods battery, noise control and lid detection in the system tray"
arch=('x86_64')
url="https://github.com/stuffz/airpods"
license=('custom')
depends=('qt6-base' 'qt6-svg' 'openssl' 'systemd-libs')
makedepends=('git' 'bluez-libs')
provides=("$_pkgname")
conflicts=("$_pkgname")
# Release builds carry no debug info, so an empty debug package would only warn.
options=('!debug')

source=("$_pkgname::git+file:///opt/code/airpods")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$_pkgname"
    # No release tags yet, so use the commit count and hash.
    printf 'r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$srcdir/$_pkgname"

    # Honour SOURCE_DATE_EPOCH so the embedded build date is reproducible.
    local build_date
    build_date="$(date -u -d "@${SOURCE_DATE_EPOCH:-$(date +%s)}" '+%Y-%m-%d %H:%M:%S')"

    make build \
        GIT_HASH="$(git rev-parse --short HEAD)" \
        BUILD_DATE="$build_date"
}

check() {
    cd "$srcdir/$_pkgname"
    # No adapter or buds in a build environment, so only prove the binary runs.
    ./build/release/airpods --version
}

package() {
    cd "$srcdir/$_pkgname"

    make install DESTDIR="$pkgdir" PREFIX=/usr

    install -Dm644 resources/linux/airpods.desktop \
        "$pkgdir/usr/share/applications/$_pkgname.desktop"

    # The desktop file's Icon=airpods resolves through the icon theme, and the
    # Wayland compositor takes a window's icon from that same desktop file.
    install -Dm644 resources/airpods.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/$_pkgname.svg"

    install -Dm644 ATTRIBUTION.md "$pkgdir/usr/share/doc/$pkgname/ATTRIBUTION.md"
    install -Dm644 docs/ble.md "$pkgdir/usr/share/doc/$pkgname/ble.md"
}
